{
  "name": "ictus-messenger",
  "private": true,
  "version": "1.0.0",
  "description": "Ictus Messenger — monorepo (frontend Vite/React + backend Session relay)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "dev": "concurrently -n \"BACK,FRONT\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "start": "node backend/dist/server.js",
    "start:prod": "pm2 start dist/server.js --name ictus-messenger --cwd backend --output /dev/null --error /dev/null",
    "stop:prod": "pm2 stop ictus-messenger",
    "restart:prod": "pm2 restart ictus-messenger",
    "deploy": "git pull && npm run build && pm2 restart ictus-messenger"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "pm2": "^7.0.4"
  }
}
